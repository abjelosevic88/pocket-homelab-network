{
  "name": "Pocket Network",
  "short_name": "Network",
  "description": "Every device on your home network: found by scanning, Tailscale, AdGuard Home and your router, with new-device review and alerts.",
  "start_url": "/",
  "display": "standalone",
  "background_color": "#f5f6f8",
  "theme_color": "#2b7a9e",
  "icons": [
    { "src": "/favicon.svg", "sizes": "any", "type": "image/svg+xml" },
    { "src": "/icon-192.png", "sizes": "192x192", "type": "image/png" },
    { "src": "/icon-512.png", "sizes": "512x512", "type": "image/png" },
    { "src": "/icon-maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" },
    { "src": "/apple-touch-icon.png", "sizes": "180x180", "type": "image/png" }
  ],
  "shortcuts": [
    { "name": "Review new devices", "url": "/review" },
    { "name": "Devices online", "url": "/devices?show=online" },
    { "name": "Add a device", "url": "/?add=1" }
  ]
}
